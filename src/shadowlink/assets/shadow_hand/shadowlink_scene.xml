<mujoco model="shadowlink_scene">
  <include file="right_hand.xml"/>
  <compiler meshdir="assets"/>

  <statistic extent="1.0"/>

  <visual>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.24 0.28 0.34" rgb2="0.06 0.07 0.09"
             width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.24 0.26 0.29" rgb2="0.17 0.19 0.21"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="24 24" reflectance="0.05"/>
    <material name="door" rgba="0.48 0.30 0.17 1" specular="0.15" shininess="0.2"/>
    <material name="frame" rgba="0.30 0.22 0.17 1"/>
    <material name="handle" rgba="0.72 0.72 0.74 1" specular="0.6" shininess="0.6"/>
  </asset>

  <worldbody>
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" pos="0 0 -0.5"
          material="grid" contype="1" conaffinity="1"/>

    <!-- Door frame: two posts and a lintel around the opening. -->
    <geom name="door_frame_left" type="box" size="0.04 0.02 0.50"
          pos="0.56 -0.49 -0.015" material="frame"
          contype="1" conaffinity="1"/>
    <geom name="door_frame_right" type="box" size="0.04 0.02 0.50"
          pos="0.56 0.045 -0.015" material="frame"
          contype="1" conaffinity="1"/>
    <geom name="door_frame_top" type="box" size="0.04 0.2675 0.025"
          pos="0.56 -0.2225 0.49" material="frame"
          contype="1" conaffinity="1"/>

    <!-- Hinged door with a graspable lever handle.  The free edge and handle
         sit near the hand's starting position; push or pull the handle to
         swing the door about the world-z hinge. -->
    <body name="door" pos="0.56 -0.44 -0.015">
      <joint name="door_hinge" type="hinge" axis="0 0 1"
             range="-1.30 1.30" damping="0.7" armature="0.01"
             frictionloss="0.02"/>
      <geom name="door_panel" type="box" size="0.0175 0.23 0.475"
            pos="0 0.23 0" mass="3.0" material="door"
            friction="0.9 0.01 0.001" condim="4"
            contype="1" conaffinity="1"/>
      <!-- Lever bar along the door face, protruding toward the hand. -->
      <geom name="door_handle_bar" type="capsule"
            fromto="-0.09 0.33 0.075  -0.09 0.40 0.075"
            size="0.012" mass="0.08" material="handle"
            friction="1.2 0.01 0.002" condim="6"
            contype="1" conaffinity="1"/>
      <geom name="door_handle_stem" type="capsule"
            fromto="-0.018 0.365 0.075  -0.09 0.365 0.075"
            size="0.012" mass="0.05" material="handle"
            friction="1.2 0.01 0.002" condim="6"
            contype="1" conaffinity="1"/>
      <geom name="door_handle_rose" type="cylinder" size="0.025 0.008"
            pos="-0.024 0.365 0.075" quat="0.7071068 0 0.7071068 0"
            mass="0.04" material="handle"
            contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
