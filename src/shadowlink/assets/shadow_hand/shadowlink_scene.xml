<mujoco model="shadowlink_scene">
  <include file="right_hand.xml"/>
  <compiler meshdir="assets"/>

  <statistic extent="1.0"/>

  <visual>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.24 0.28 0.34" rgb2="0.06 0.07 0.09"
             width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.24 0.26 0.29" rgb2="0.17 0.19 0.21"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="24 24" reflectance="0.05"/>
    <material name="table" rgba="0.45 0.29 0.16 1" specular="0.1" shininess="0.15"/>
    <material name="table_leg" rgba="0.30 0.22 0.16 1"/>
    <material name="block" rgba="0.85 0.35 0.15 1" specular="0.3" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" pos="0 0 -0.5"
          material="grid" contype="1" conaffinity="1"/>

    <!-- Tabletop under the hand. The hand starts palm-down about 12 cm above
         this surface, so it can descend and grasp the small block. -->
    <geom name="table_top" type="box" size="0.42 0.32 0.015"
          pos="0.36 0.0 -0.235" material="table"
          friction="0.8 0.01 0.001" contype="1" conaffinity="1"/>
    <geom name="table_leg_fl" type="box" size="0.022 0.022 0.125"
          pos="0.05 -0.27 -0.375" material="table_leg"
          contype="1" conaffinity="1"/>
    <geom name="table_leg_fr" type="box" size="0.022 0.022 0.125"
          pos="0.05 0.27 -0.375" material="table_leg"
          contype="1" conaffinity="1"/>
    <geom name="table_leg_bl" type="box" size="0.022 0.022 0.125"
          pos="0.67 -0.27 -0.375" material="table_leg"
          contype="1" conaffinity="1"/>
    <geom name="table_leg_br" type="box" size="0.022 0.022 0.125"
          pos="0.67 0.27 -0.375" material="table_leg"
          contype="1" conaffinity="1"/>

    <!-- Small free cube on the tabletop. -->
    <body name="block" pos="0.50 0.0 -0.195">
      <freejoint name="block_free"/>
      <geom name="block" type="box" size="0.025 0.025 0.025" mass="0.01"
            material="block" friction="2.0 0.05 0.005" condim="6"
            solimp="0.9 0.99 0.0001" solref="0.004 1"
            contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
