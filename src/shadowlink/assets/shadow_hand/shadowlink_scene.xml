<mujoco model="shadowlink_scene">
  <include file="right_hand.xml"/>
  <compiler meshdir="assets"/>

  <statistic extent="0.3"/>

  <visual>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.24 0.28 0.34" rgb2="0.06 0.07 0.09"
             width="512" height="3072"/>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.24 0.26 0.29" rgb2="0.17 0.19 0.21"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="24 24" reflectance="0.05"/>
    <material name="ball" rgba="0.85 0.35 0.15 1"/>
    <material name="stand" rgba="0.38 0.40 0.44 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" pos="0 0 -0.5"
          material="grid" contype="1" conaffinity="1"/>
    <!-- Grasp target: a free ball on a small stand at palm height.  Move the
         hand toward it and close the fingers; the ball is fully dynamic. -->
    <geom name="stand" type="cylinder" size="0.012 0.26" pos="0.49 -0.01 -0.24"
          material="stand" contype="1" conaffinity="1"/>
    <geom name="stand_base" type="cylinder" size="0.06 0.008" pos="0.49 -0.01 -0.492"
          material="stand" contype="1" conaffinity="1"/>
    <body name="ball" pos="0.49 -0.01 0.061">
      <freejoint name="ball_free"/>
      <geom name="ball" type="sphere" size="0.04" mass="0.05"
            material="ball" friction="1.2 0.01 0.002" condim="6"/>
    </body>
  </worldbody>
</mujoco>
